{
  "name": "storie",
  "version": "2.0.0-alpha.1",
  "description": "S|torie - Interactive story and game engine rebuilt with SES sandboxing and modern web APIs",
  "type": "module",
  "main": "./dist/main.js",
  "types": "./dist/main.d.ts",
  "exports": {
    ".": {
      "types": "./dist/main.d.ts",
      "import": "./dist/main.js"
    },
    "./content-source": {
      "types": "./dist/content-source.d.ts",
      "import": "./dist/content-source.js"
    },
    "./compile": {
      "types": "./dist/compile/compile.d.ts",
      "import": "./dist/compile/compile.js"
    },
    "./analyze": {
      "types": "./dist/compile/analyze.d.ts",
      "import": "./dist/compile/analyze.js"
    },
    "./worlds": {
      "types": "./dist/worlds.d.ts",
      "import": "./dist/worlds.js"
    },
    "./worlds-content": {
      "types": "./dist/worlds-content.d.ts",
      "import": "./dist/worlds-content.js"
    },
    "./worlds-timeline": {
      "types": "./dist/worlds-timeline.d.ts",
      "import": "./dist/worlds-timeline.js"
    },
    "./audio/sfx-graph-document": {
      "types": "./dist/audio/sfx-graph-document.d.ts",
      "import": "./dist/audio/sfx-graph-document.js"
    },
    "./sequencer/document": {
      "types": "./dist/sequencer/document.d.ts",
      "import": "./dist/sequencer/document.js"
    },
    "./modules/loader": {
      "types": "./dist/modules/loader.d.ts",
      "import": "./dist/modules/loader.js"
    },
    "./modules/types": {
      "types": "./dist/modules/types.d.ts",
      "import": "./dist/modules/types.js"
    },
    "./runtime/audio-pack": {
      "types": "./dist/runtime/audio-pack.d.ts",
      "import": "./dist/runtime/audio-pack.js"
    },
    "./runtime/capability-api": {
      "types": "./dist/runtime/capability-api.d.ts",
      "import": "./dist/runtime/capability-api.js"
    },
    "./runtime/authored-tools-pack": {
      "types": "./dist/runtime/authored-tools-pack.d.ts",
      "import": "./dist/runtime/authored-tools-pack.js"
    },
    "./runtime/gui-pack": {
      "types": "./dist/runtime/gui-pack.d.ts",
      "import": "./dist/runtime/gui-pack.js"
    },
    "./runtime/text-pack": {
      "types": "./dist/runtime/text-pack.d.ts",
      "import": "./dist/runtime/text-pack.js"
    },
    "./runtime/ui-document-pack": {
      "types": "./dist/runtime/ui-document-pack.d.ts",
      "import": "./dist/runtime/ui-document-pack.js"
    },
    "./runtime/webgpu-pack": {
      "types": "./dist/runtime/webgpu-pack.d.ts",
      "import": "./dist/runtime/webgpu-pack.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run check:authoring && npm run build:lib && npm run build:site-runtime && npm run build:site",
    "build:lib": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\" && tsc && vite build",
    "build:site-runtime": "vite build --config vite.site.config.ts",
    "build:site": "node scripts/build-site.js",
    "check:authoring": "node scripts/check-authored-conditionals.js",
    "compile:app": "npm run build:lib && node scripts/compile-app.js",
    "validate:app": "npm run build:lib && node scripts/validate-app.js",
    "generate-favicons": "node scripts/generate-favicons.js",
    "preview": "vite preview --outDir docs",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "tauri": "tauri",
    "dev:tauri": "tauri dev",
    "build:tauri": "tauri build"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "mp4-muxer": "^5.2.2",
    "ses": "^1.14.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/node": "^20.11.0",
    "@webgpu/types": "^0.1.69",
    "sharp": "^0.34.5",
    "terser": "^5.46.0",
    "typescript": "^5.3.3",
    "vite": "^5.0.12",
    "vitest": "^1.2.1"
  },
  "keywords": [
    "terminal",
    "markdown",
    "stories",
    "sandboxing",
    "ses",
    "webgpu"
  ],
  "author": "MaddestLabs",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/maddestlabs/storie.git"
  }
}
