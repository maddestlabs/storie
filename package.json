{
  "name": "storie",
  "version": "2.0.0-alpha.1",
  "description": "S|torie - Interactive story and game engine rebuilt with SES sandboxing and modern web APIs",
  "type": "module",
  "main": "dist/storie.js",
  "types": "dist/storie.d.ts",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:lib && npm run build:site",
    "build:lib": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\" && tsc && vite build",
    "build:site": "node scripts/build-site.js",
    "preview": "vite preview --outDir docs",
    "typecheck": "tsc --noEmit",
    "test": "vitest"
  },
  "dependencies": {
    "ses": "^1.14.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@webgpu/types": "^0.1.69",
    "terser": "^5.46.0",
    "typescript": "^5.3.3",
    "vite": "^5.0.12",
    "vitest": "^1.2.1"
  },
  "keywords": [
    "terminal",
    "markdown",
    "stories",
    "sandboxing",
    "ses",
    "webgpu"
  ],
  "author": "MaddestLabs",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/maddestlabs/storie.git"
  }
}
