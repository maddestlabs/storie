{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "storie",
  "version": "2.0.0",
  "identifier": "com.maddestlabs.storie",
  "build": {
    "frontendDist": "../docs",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "S|torie",
        "width": 1280,
        "height": 800,
        "minWidth": 640,
        "minHeight": 400,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "center": true,
        "dragDropEnabled": true,
        "devtools": true,
        "additionalBrowserArgs": "--enable-features=Vulkan,UseSkiaRenderer --disable-features=RendererCodeIntegrity"
      }
    ],
    "security": {
      "csp": "default-src 'self' asset: https://asset.localhost; script-src 'self' 'unsafe-eval' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: https://asset.localhost data: blob:; font-src 'self' asset: https://asset.localhost data:; connect-src 'self' asset: https://asset.localhost ipc: http://ipc.localhost https://api.github.com; media-src 'self' asset: https://asset.localhost blob: data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": [
      "icons/favicon.ico",
      "icons/favicon-16x16.png",
      "icons/favicon-32x32.png",
      "icons/android-chrome-192x192.png",
      "icons/android-chrome-512x512.png",
      "icons/apple-touch-icon.png"
    ],
    "resources": {}
  }
}
